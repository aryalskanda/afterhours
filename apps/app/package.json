{
  "name": "afterhours-app",
  "version": "0.1.0",
  "private": true,
  "description": "The Afterhours app: your machines' Claude Code queues, on your phone, the web and the desktop",
  "license": "Apache-2.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist-web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "e2e:web": "bun e2e/web.e2e.ts",
    "e2e:engine": "bun e2e/engine.e2e.ts"
  },
  "dependencies": {
    "@afterhours/protocol": "file:../../packages/protocol",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.2.4",
    "expo": "57.0.26",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "typescript": "~6.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "puppeteer-core": "25.12.0"
  }
}
